{
  "openapi": "3.1.0",
  "info": {
    "title": "MerchantPay 模拟商户支付 API",
    "version": "1.0.0-SNAPSHOT",
    "description": "HMAC五段签名与通知验签见 merchant-api.md。202仅表示持久化受理。API JSON金额必须为字符串。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080/api/v1",
      "description": "仅本机模拟环境"
    }
  ],
  "security": [
    {
      "MerchantKey": []
    }
  ],
  "paths": {
    "/payments": {
      "parameters": [
        {
          "name": "X-Timestamp",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          }
        },
        {
          "name": "X-Nonce",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{16,100}$"
          }
        },
        {
          "name": "X-Signature",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        {
          "name": "X-Api-Version",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "1.0"
            ],
            "default": "1.0"
          }
        }
      ],
      "post": {
        "operationId": "createPayment",
        "description": "受理支付；相同业务号和参数返回原对象",
        "responses": {
          "202": {
            "description": "受理支付；相同业务号和参数返回原对象",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "日志关联标识"
              }
            }
          },
          "400": {
            "description": "参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "认证无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "权限不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "不存在或不属于该商户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "幂等、重放、额度或状态冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "超过配额",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "可能已提交；原业务号查询及退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Retry delay in seconds; reuse the original business key with a new nonce.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "X-Retry-Reason": {
                "description": "Fixed retry classification; unknown or absent values are UNCLASSIFIED.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "API_INFLIGHT",
                    "QUOTA_CAPACITY",
                    "QUOTA_TIMEOUT",
                    "QUOTA_INTERRUPTED",
                    "QUOTA_UNAVAILABLE",
                    "QUOTA_DATABASE",
                    "PAYMENT_CAPACITY",
                    "DATABASE_UNAVAILABLE",
                    "DATABASE_TRANSIENT",
                    "UNCLASSIFIED"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "未分类5xx也可能已提交；先以原业务号查单，再退避重试。"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayment"
              }
            }
          }
        }
      }
    },
