  "components": {
    "securitySchemes": {
      "MerchantKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Key-Id",
        "description": "还必须带时间、nonce和HMAC签名；不是仅凭keyId认证"
      }
    },
    "schemas": {
      "CreatePayment": {
        "type": "object",
        "required": [
          "merchantOrderNo",
          "amountMinor",
          "currency",
          "channel"
        ],
        "properties": {
          "merchantOrderNo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^([1-9][0-9]{0,8}|1000000000)$",
            "example": "10000"
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "MOCK_A",
              "MOCK_B"
            ]
          },
          "notificationUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
