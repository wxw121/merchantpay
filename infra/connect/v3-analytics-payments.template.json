{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "__MYSQL_HOST__",
  "database.port": "__MYSQL_PORT__",
  "database.user": "__CDC_USER__",
  "database.password": "${env:__CDC_PASSWORD_ENV__}",
  "database.server.id": "__UNIQUE_ANALYTICS_SERVER_ID__",
  "database.include.list": "__DATABASE__",
  "table.include.list": "__DATABASE__.payments,__DATABASE__.v3_shard_routes",
  "topic.prefix": "merchantpay-v3-analytics-s__SHARD_ID__",
  "schema.history.internal.kafka.bootstrap.servers": "__KAFKA_BOOTSTRAP__",
  "schema.history.internal.kafka.topic": "merchantpay-v3-analytics-s__SHARD_ID__-schema-history",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "snapshot.mode": "initial",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
