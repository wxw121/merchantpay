{
  "connector.class":"io.debezium.connector.mysql.MySqlConnector",
  "tasks.max":"1",
  "database.hostname":"mysql",
  "database.port":"3306",
  "database.user":"${env:V2_CDC_USER}",
  "database.password":"${env:V2_CDC_PASSWORD}",
  "database.server.id":"184002",
  "database.include.list":"merchantpay",
  "table.include.list":"merchantpay.domain_events",
  "topic.prefix":"merchantpay-v2",
  "schema.history.internal.kafka.bootstrap.servers":"kafka:9092",
  "schema.history.internal.kafka.topic":"merchantpay-v2-schema-history",
  "include.schema.changes":"false",
  "tombstones.on.delete":"false",
  "snapshot.mode":"initial",
  "key.converter":"org.apache.kafka.connect.storage.StringConverter",
  "value.converter":"org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable":"false",
  "transforms":"outbox",
  "transforms.outbox.type":"io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id":"event_id",
  "transforms.outbox.table.field.event.key":"aggregateid",
  "transforms.outbox.table.field.event.type":"event_type",
  "transforms.outbox.table.expand.json.payload":"true",
  "transforms.outbox.table.op.invalid.behavior":"fatal",
  "transforms.outbox.route.by.field":"aggregatetype",
  "transforms.outbox.route.topic.replacement":"outbox.event.${routedByValue}"
}
