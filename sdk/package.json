{
  "name": "@merchantpay/node-sdk",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "Generated MerchantPay V1 client for trusted Node.js servers",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.25.0",
  "exports": { ".": { "types": "./dist/index.d.ts", "node": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "generate": "node ../scripts/api/generate-client.mjs",
    "check:generated": "node ../scripts/api/generate-client.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "verify": "pnpm check:generated && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node ../scripts/api/smoke-client.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
